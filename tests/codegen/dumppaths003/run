. ../../testutils.sh

rm -f Main.paths Main.paths.parts Main extract
rm -rf build

idris2 --dumppaths-json Main.paths -o Main Main.idr

# Only the Point field paths: exactly the (.x)/(.y) projections, never the plain
# Main.Point.x / Main.Point.y selector wrappers. Projected in Idris (contrib
# Language.JSON), then sorted -- no external post-processor.
idris2 --source-dir .. -p contrib -o extract ../PathsExtract.idr
./build/exec/extract Main.paths \
  | awk -F'\t' 'index($1,"Main.Point.")==1 {print $1, $2, $4}' \
  | safesort
